            user-select: none;
        }

        body {
            overflow: hidden;
            background-color: #000;
            font-family: 'Courier New', Courier, monospace;
        }

        /* UI Styling */
        #gameUI {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none; /* Allows clicking through UI */
            z-index: 10;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
        }

        .score-board {
            color: #fff;
            font-size: 24px;
            font-weight: bold;
            text-shadow: 0 0 10px #ffea00, 0 0 20px #ffea00;
        }

        #score {
            color: #ffea00;
            font-size: 32px;
        }

        /* Health Bar */
        .health-container {
            width: 300px;
            height: 25px;
            background: rgba(0, 0, 0, 0.7);
            border: 2px solid #fff;
            border-radius: 5px;
            position: relative;
            box-shadow: 0 0 10px #00ff00;
        }

        #healthBar {
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, #ff0000, #00ff00);
            transition: width 0.2s ease;
        }

        #hpText {
            position: absolute;
            width: 100%;
            text-align: center;
            color: white;
            font-weight: bold;
            top: 2px;
            font-size: 16px;
            text-shadow: 1px 1px 2px black;
        }

        /* Game Over Screen */
        #gameOverScreen {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(10, 20, 10, 0.9);
            padding: 40px;
            border: 3px solid #ffea00;
            border-radius: 10px;
            text-align: center;
            color: #fff;
            display: none;
            pointer-events: auto;
            box-shadow: 0 0 30px #ffea00;
            z-index: 20;
        }

        #gameOverScreen h1 {
            color: #ffea00;
            margin-bottom: 10px;
            text-shadow: 0 0 10px #ffea00;
            font-size: 36px;
        }

        #gameOverScreen h2 {
            color: #ff3333;
            margin-bottom: 20px;
            font-size: 28px;
        }

        #gameOverScreen p {
            font-size: 24px;
            margin-bottom: 30px;
        }

        button {
            padding: 15px 30px;
            font-size: 20px;
            font-weight: bold;
            color: #000;
            background: #ffea00;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            box-shadow: 0 0 15px #ffea00;
            transition: 0.2s;
        }

        button:hover {
            background: #fff;
            box-shadow: 0 0 25px #fff;
        }

        canvas {
            display: block;
        }
    </style>
</head>
<body>

    <div id="gameUI">
        <div class="top-bar">
            <div class="health-container">
                <div id="healthBar"></div>
                <div id="hpText">100 / 100 HP</div>
            </div>
            <div class="score-board">KILLS: <span id="score">0</span></div>
        </div>
    </div>

    <div id="gameOverScreen">
        <h1 id="wwcdText">WINNER WINNER CHICKEN DINNER!</h1>
        <h2 id="goText">GAME OVER</h2>
        <p>Total Bots Killed: <span id="finalScore">0</span></p>
        <button onclick="restartGame()">PLAY AGAIN</button>
    </div>

    <canvas id="gameCanvas"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // UI Elements
        const scoreEl = document.getElementById('score');
        const healthBarEl = document.getElementById('healthBar');
        const hpTextEl = document.getElementById('hpText');
        const gameOverScreen = document.getElementById('gameOverScreen');
        const finalScoreEl = document.getElementById('finalScore');
        const wwcdText = document.getElementById('wwcdText');

        // Resize Canvas
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });

        // Game Variables
        let animationId;
        let score = 0;
        let frames = 0;
        let gameActive = true;

        // Player configuration
        const player = {
            x: canvas.width / 2,
            y: canvas.height / 2,
            radius: 18,
            color: '#1a1a1a', // Helmet color (Dark)
            speed: 4,
            hp: 100,
            maxHp: 100,
            angle: 0
        };

        // Arrays to hold entities
        let bullets = [];
        let enemies = [];
        let particles = [];

        // Input Tracking
        const keys = {
            w: false, a: false, s: false, d: false
        };
        const mouse = {
            x: canvas.width / 2, y: canvas.height / 2
        };

        // Event Listeners for Movement
        window.addEventListener('keydown', (e) => {
            if(e.key === 'w' || e.key === 'W') keys.w = true;
            if(e.key === 'a' || e.key === 'A') keys.a = true;
            if(e.key === 's' || e.key === 'S') keys.s = true;
            if(e.key === 'd' || e.key === 'D') keys.d = true;
        });

        window.addEventListener('keyup', (e) => {
            if(e.key === 'w' || e.key === 'W') keys.w = false;
            if(e.key === 'a' || e.key === 'A') keys.a = false;
            if(e.key === 's' || e.key === 'S') keys.s = false;
            if(e.key === 'd' || e.key === 'D') keys.d = false;
        });

        // Mouse Move for Aiming
        window.addEventListener('mousemove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
        });

        // Mouse Click for Shooting
        window.addEventListener('mousedown', (e) => {
            if (!gameActive) return;
            
            // Calculate bullet velocity based on angle
            const angle = Math.atan2(e.clientY - player.y, e.clientX - player.x);
            const velocity = {
                x: Math.cos(angle) * 12, // Bullet Speed
                y: Math.sin(angle) * 12
            };

            // Add new bullet
            bullets.push({
                x: player.x + Math.cos(angle) * 30, // Spawn at gun tip
                y: player.y + Math.sin(angle) * 30,
                radius: 4,
                color: '#ffea00', // Yellow bullet
                velocity: velocity
            });
        });

        // Classes/Objects representation via functions
        function drawPlayer() {
            // Calculate angle towards mouse
            player.angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);

            ctx.save();
            ctx.translate(player.x, player.y);
            ctx.rotate(player.angle);

            // Draw Gun
            ctx.fillStyle = '#333';
            ctx.fillRect(10, -5, 25, 10);

            // Draw Player Body (Helmet)
            ctx.beginPath();
            ctx.arc(0, 0, player.radius, 0, Math.PI * 2, false);
            ctx.fillStyle = '#4a5d23'; // Military Green Body
            ctx.fill();
            ctx.lineWidth = 3;
            ctx.strokeStyle = player.color;
            ctx.stroke();
            
            // Draw Backpack
            ctx.fillStyle = '#2c3e18';
            ctx.fillRect(-22, -12, 10, 24);

            ctx.restore();
        }

        function spawnEnemy() {
            const radius = Math.random() * (20 - 14) + 14; // Bot size
            let x, y;

            // Spawn randomly from edges
            if (Math.random() < 0.5) {
                x = Math.random() < 0.5 ? 0 - radius : canvas.width + radius;
                y = Math.random() * canvas.height;
            } else {
                x = Math.random() * canvas.width;
                y = Math.random() < 0.5 ? 0 - radius : canvas.height + radius;
            }

            const color = '#cc0000'; // Red Bots

            enemies.push({ x, y, radius, color, speed: Math.random() * 1.5 + 1 });
        }

        // Particle effect for explosion
        function createParticles(x, y, color) {
            for (let i = 0; i < 8; i++) {
                particles.push({
                    x: x,
                    y: y,
                    radius: Math.random() * 3,
                    color: color,
                    velocity: {
                        x: (Math.random() - 0.5) * (Math.random() * 6),
                        y: (Math.random() - 0.5) * (Math.random() * 6)
                    },
                    alpha: 1
                });
            }
        }

        // Draw Map Background (Erangel Vibe)
        function drawBackground() {
            ctx.fillStyle = '#556b2f'; // Olive Green map base
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Grid lines for tactical feel
            ctx.strokeStyle = 'rgba(0, 0, 0, 0.1)';
            ctx.lineWidth = 1;
            for(let i = 0; i < canvas.width; i+=100) {
                ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, canvas.height); ctx.stroke();
            }
            for(let i = 0; i < canvas.height; i+=100) {
                ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(canvas.width, i); ctx.stroke();
            }
        }

        // Main Game Loop
        function animate() {
            if (!gameActive) return;
            animationId = requestAnimationFrame(animate);
            frames++;

            // Clear & Draw Background
            drawBackground();

            // Player Movement Logic (Normalizing diagonal speed)
            let dx = 0; let dy = 0;
            if (keys.w) dy -= 1;
            if (keys.s) dy += 1;
            if (keys.a) dx -= 1;
            if (keys.d) dx += 1;

            if (dx !== 0 && dy !== 0) {
                const length = Math.sqrt(dx * dx + dy * dy);
                dx /= length; dy /= length;
            }

            player.x += dx * player.speed;
            player.y += dy * player.speed;

            // Keep player inside map
            player.x = Math.max(player.radius, Math.min(canvas.width - player.radius, player.x));
            player.y = Math.max(player.radius, Math.min(canvas.height - player.radius, player.y));

            // Draw Player
            drawPlayer();

            // Handle Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                if (p.alpha <= 0) {
                    particles.splice(i, 1);
                } else {
                    p.velocity.x *= 0.98; // Friction
                    p.velocity.y *= 0.98;
                    p.x += p.velocity.x;
                    p.y += p.velocity.y;
                    p.alpha -= 0.02; // Fade out

                    ctx.save();
                    ctx.globalAlpha = p.alpha;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2, false);
                    ctx.fillStyle = p.color;
                    ctx.fill();
                    ctx.restore();
                }
            }

            // Handle Bullets
            for (let i = bullets.length - 1; i >= 0; i--) {
                const bullet = bullets[i];
                bullet.x += bullet.velocity.x;
                bullet.y += bullet.velocity.y;

                // Draw bullet
                ctx.beginPath();
                ctx.arc(bullet.x, bullet.y, bullet.radius, 0, Math.PI * 2, false);
                ctx.fillStyle = bullet.color;
                ctx.fill();
                ctx.shadowBlur = 10;
                ctx.shadowColor = bullet.color;

                // Remove bullet if off screen
                if (bullet.x < 0 || bullet.x > canvas.width || bullet.y < 0 || bullet.y > canvas.height) {
                    bullets.splice(i, 1);
                }
            }

            // Handle Enemies (Bots)
            for (let i = enemies.length - 1; i >= 0; i--) {
                const enemy = enemies[i];

                // Calculate angle towards player
                const angle = Math.atan2(player.y - enemy.y, player.x - enemy.x);
                enemy.x += Math.cos(angle) * enemy.speed;
                enemy.y += Math.sin(angle) * enemy.speed;

                // Draw Enemy
                ctx.save();
                ctx.translate(enemy.x, enemy.y);
                ctx.rotate(angle);
                // Enemy Gun
                ctx.fillStyle = '#111';
                ctx.fillRect(8, -3, 15, 6);
                // Enemy Body
                ctx.beginPath();
                ctx.arc(0, 0, enemy.radius, 0, Math.PI * 2, false);
                ctx.fillStyle = enemy.color;
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#550000';
                ctx.stroke();
                ctx.restore();

                // 1. Check Collision with Player
                const distPlayer = Math.hypot(player.x - enemy.x, player.y - enemy.y);
                if (distPlayer - enemy.radius - player.radius < 1) {
                    // Enemy hits player
                    player.hp -= 20; // 20 Damage per hit
                    updateHealthBar();
                    createParticles(player.x, player.y, '#ff0000');
                    enemies.splice(i, 1); // Remove enemy

                    // Game Over Check
                    if (player.hp <= 0) {
                        endGame();
                    }
                    continue; // Skip bullet check since enemy is dead
                }

                // 2. Check Collision with Bullets
                for (let j = bullets.length - 1; j >= 0; j--) {
                    const bullet = bullets[j];
                    const distBullet = Math.hypot(bullet.x - enemy.x, bullet.y - enemy.y);

                    if (distBullet - enemy.radius - bullet.radius < 1) {
                        // Enemy Killed
                        score++;
                        scoreEl.innerHTML = score;
                        
                        // Create blood/explosion effect
                        createParticles(enemy.x, enemy.y, enemy.color);

                        // Remove Enemy and Bullet
                        enemies.splice(i, 1);
                        bullets.splice(j, 1);
                        break; // Stop checking bullets for this enemy
                    }
                }
            }

            // Spawn Enemies periodically (Spawn rate increases slightly over time)
            let spawnRate = Math.max(60, 150 - Math.floor(frames / 100)); // Becomes faster
            if (frames % spawnRate === 0) {
                spawnEnemy();
            }
        }

        function updateHealthBar() {
            player.hp = Math.max(0, player.hp);
            const percentage = (player.hp / player.maxHp) * 100;
            healthBarEl.style.width = percentage + '%';
            hpTextEl.innerHTML = `${player.hp} / ${player.maxHp} HP`;

            if(player.hp < 40) {
                healthBarEl.style.background = "#ff0000"; // Red when low HP
            } else {
                healthBarEl.style.background = "linear-gradient(90deg, #ff0000, #00ff00)";
            }
        }

        function endGame() {
            gameActive = false;
            cancelAnimationFrame(animationId);
            
            // Show Game Over UI
            finalScoreEl.innerHTML = score;
            if(score > 30) {
                wwcdText.innerHTML = "WINNER WINNER CHICKEN DINNER!";
                wwcdText.style.color = "#ffea00";
            } else {
                wwcdText.innerHTML = "BETTER LUCK NEXT TIME!";
                wwcdText.style.color = "#aaaaaa";
            }
            gameOverScreen.style.display = 'block';
        }

        function restartGame() {
            // Reset variables
            player.x = canvas.width / 2;
            player.y = canvas.height / 2;
            player.hp = player.maxHp;
            score = 0;
            frames = 0;
            bullets = [];
            enemies = [];
            particles = [];
            
            // Reset UI
            scoreEl.innerHTML = score;
            updateHealthBar();
            gameOverScreen.style.display = 'none';
            gameActive = true;

            // Restart Loop
            animate();
        }

        // Start Game
        animate();

    </script>
</body>
</html>
