 html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>exam60 AI: The Luxury Class 10th GK Ecosystem</title>
    <!-- Tailwind CSS for Modern Styling -->
    <script src="https://tailwindcss.com"></script>
    <style>
        @import url('https://googleapis.com');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-tech { font-family: 'Orbitron', sans-serif; }
        /* Premium Background Gradient Effect */
        .premium-bg {
            background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #0f172a 70%, #020617 100%);
        }
        /* Glassmorphism Effect for Heavy Cards */
        .glass-card {
            background: rgba(30, 41, 59, 0.45);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        /* Neon Glow Effects */
        .glow-red { shadow: 0 0 20px rgba(239, 68, 68, 0.4); }
        .neon-border-active { border-color: #f43f5e; box-shadow: 0 0 15px rgba(244, 63, 94, 0.3); }
    </style>
</head>
<body class="premium-bg text-slate-100 min-h-screen antialiased selection:bg-rose-500 selection:text-white">

    <!-- 1. Luxury Floating Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-slate-950/70 backdrop-blur-md border-b border-slate-800/60">
        <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-gradient-to-r from-rose-600 to-amber-500 font-tech font-extrabold text-xl px-4 py-2 rounded-xl text-white tracking-widest shadow-[0_0_20px_rgba(225,29,72,0.3)]">
                    EXAM60
                </div>
                <div class="hidden sm:flex h-5 w-[1px] bg-slate-800"></div>
                <span class="text-[10px] font-tech uppercase tracking-[0.25em] text-rose-400 bg-rose-950/40 border border-rose-800/50 px-2.5 py-1 rounded-md font-bold">
                    BSEB AI-ECOSYSTEM v2.0
                </span>
            </div>
            <div class="flex items-center gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-tech font-bold text-emerald-400 tracking-wider">LIVE CENTRAL</span>
            </div>
        </div>
    </nav>

    <!-- Main Dynamic Content Container -->
    <main class="max-w-4xl mx-auto px-4 py-8 md:py-16">
        
        <!-- 2. Hero Luxury Typography -->
        <div class="text-center mb-12 md:mb-16">
            <div class="inline-flex items-center gap-2 bg-slate-900/80 border border-slate-800 rounded-full px-4 py-1.5 mb-4 shadow-inner">
                <span class="text-amber-400 text-sm">✨</span>
                <span class="text-xs font-semibold text-slate-400 tracking-wide uppercase">Elite Cognitive Learning Platform</span>
            </div>
            <h1 class="text-3xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-b from-white via-slate-200 to-slate-500 tracking-tight leading-none mb-4">
                The Next-Gen Class 10th GK
            </h1>
            <p class="max-w-xl mx-auto text-slate-400 text-sm md:text-base leading-relaxed font-medium">
                बिहार बोर्ड मैट्रिक, NTSE और राज्यस्तरीय ओलंपियाड को डोमिनेट करने के लिए विशेष रूप से डिज़ाइन किया गया प्रीमियम डिजिटल आर्किटेक्चर।
            </p>
        </div>

        <!-- 3. Heavy Luxury Feature Dashboard: Neuro-Adaptive Quiz -->
        <div class="glass-card rounded-3xl shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)] p-6 md:p-10 mb-8 max-w-2xl mx-auto relative overflow-hidden">
            <!-- Subtle Decorative Light Leak -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-rose-600/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <!-- Dashboard Card Top Control Row -->
            <div class="flex justify-between items-center border-b border-slate-800/80 pb-6 mb-6">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-lg">
                        🧠
                    </div>
                    <div>
                        <h2 class="font-extrabold text-slate-100 text-sm md:text-base tracking-wide uppercase">01. Neuro-Adaptive Engine</h2>
                        <p class="text-[11px] font-tech text-rose-400 tracking-widest uppercase" id="q-counter">MATRIX CORE / 01</p>
                    </div>
                </div>
                <!-- Premium High-Tech Timer -->
                <div class="bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-right shadow-inner min-w-[85px]">
                    <div class="text-[9px] font-tech text-slate-500 tracking-wider uppercase mb-0.5">TIME REMAINING</div>
                    <div class="font-tech text-sm font-bold text-amber-400 tracking-widest"><span id="timer-display">20</span>S</div>
                </div>
            </div>

            <!-- Quiz Display Arena -->
            <div id="interactive-arena">
                <h3 class="text-lg md:text-xl font-bold text-white mb-6 leading-relaxed tracking-wide" id="target-question">
                    ...
                </h3>

                <!-- Premium Styled Heavy Buttons Layout -->
                <div class="space-y-3.5" id="response-options">
                    <!-- Dynamic Interactive Options Housed Here -->
                </div>
            </div>

            <!-- Dashboard Footer Controls -->
            <div class="flex justify-between items-center border-t border-slate-800/80 mt-8 pt-6">
                <div>
                    <div class="text-[9px] font-tech text-slate-500 tracking-wider uppercase mb-0.5">ACCURACY RATING</div>
                    <div class="text-sm font-bold text-emerald-400 font-tech tracking-wider">SCORE: <span id="live-score">0</span></div>
                </div>
                <button id="forward-trigger" onclick="advanceStage()" class="hidden bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 text-white font-bold text-xs uppercase tracking-widest px-6 py-3.5 rounded-xl transition duration-200 shadow-[0_4px_20px_rgba(225,29,72,0.25)] border border-rose-500/30">
                    Next Metric ➔
                </button>
            </div>
        </div>

    </main>

    <!-- 4. Production Grade Logic Script -->
    <script>
        const structuralData = [
            {
                q: "1. 'नेपोलियन संहिता' (Napoleonic Code) किस वर्ष लागू की गई थी?",
                opts: ["वर्ष 1789 में", "वर्ष 1791 में", "वर्ष 1801 में", "वर्ष 1804 में"],
                correctIndex: 3
            },
            {
                q: "2. कार्ल मार्क्स का ऐतिहासिक जन्म कहाँ हुआ था?",
                opts: ["संयुक्त साम्राज्य (इंग्लैंड)", "जर्मनी साम्राज्य", "इटली गणराज्य", "रूसी साम्राज्य"],
                correctIndex: 1
            },
            {
                q: "3. बिहार राज्य में ऐतिहासिक रज्जू मार्ग (Ropeway) कहाँ अवस्थित है?",
                opts: ["बिहारशरीफ", "राजगीर", "पवित्र गया", "बांका जनपद"],
                correctIndex: 1
            }
        ];

        let internalPointer = 0;
        let dynamicScore = 0;
        let countdown = 20;
        let activeClock;

        function initializeSystem() {
            clearInterval(activeClock);
            countdown = 20;
            document.getElementById("timer-display").innerText = countdown;
            document.getElementById("forward-trigger").classList.add("hidden");

            const currentPayload = structuralData[internalPointer];
            document.getElementById("q-counter").innerText = `MATRIX CORE / 0${internalPointer + 1}`;
            document.getElementById("target-question").innerText = currentPayload.q;

            const grid = document.getElementById("response-options");
            grid.innerHTML = "";

            currentPayload.opts.forEach((optText, index) => {
                const node = document.createElement("button");
                // Base Luxury Style for Glass Buttons
                node.className = "w-full text-left p-4 md:p-5 rounded-2xl border border-slate-800 bg-slate-900/40 hover:bg-slate-800/40 hover:border-slate-700 font-semibold text-slate-300 transition duration-150 text-sm md:text-base block tracking-wide";
                node.innerText = optText;
                node.onclick = () => evaluationSequence(index, node);
                grid.appendChild(node);
            });

            activeClock = setInterval(() => {
                countdown--;
                document.getElementById("timer-display").innerText = countdown;
                if(countdown <= 0) {
                    clearInterval(activeClock);
                    freezeInteractions();
                    exposeSolution();
                }
            }, 1000);
        }

        function evaluationSequence(userChoice, element) {
            clearInterval(activeClock);
            const actualAnswer = structuralData[internalPointer].correctIndex;
            const peers = document.getElementById("response-options").children;

            if(userChoice === actualAnswer) {
                element.className = "w-full text-left p-4 md:p-5 rounded-2xl border-2 border-emerald-500 bg-emerald-950/30 font-bold text-emerald-400 text-sm md:text-base block shadow-[0_0_15px_rgba(16,185,129,0.15)] tracking-wide";
                dynamicScore++;
                document.getElementById("live-score").innerText = dynamicScore;
            } else {
