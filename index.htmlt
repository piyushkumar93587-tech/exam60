from fastapi import FastAPI
from pydantic import BaseModel
import openai

app = FastAPI()

class TaskInput(BaseModel):
    task_name: str
    duration: int  # minutes mein
    energy_level_required: str  # High, Medium, Low

@app.post("/auto-schedule")
def generate_schedule(task: TaskInput, user_peak_energy: str):
    # Logic: Agar task high energy ka hai aur user ka peak time wahi hai, toh slot assign karo
    if task.energy_level_required == user_peak_energy:
        assigned_slot = "09:00 AM - 10:00 AM (Peak Productivity Window)"
    else:
        assigned_slot = "03:00 PM - 04:00 PM (Relaxed Window)"
        
    return {
        "status": "Success",
        "task": task.task_name,
        "recommended_slot": assigned_slot,
        "message": "Aapka schedule aapke energy levels ke hisaab se optimize kar diya gaya hai."
    }
